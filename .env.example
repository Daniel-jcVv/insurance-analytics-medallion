# MinIO Configuration (for local development)
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminpassword123
MINIO_BUCKET=insurance-data
MINIO_SECURE=False

# AWS S3 Configuration (for cloud/Fabric integration)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=insurance-data-fabric

# Fabric Configuration (actual credentials are configured in Fabric)
FABRIC_WORKSPACE_ID=your-workspace-id
FABRIC_LAKEHOUSE_NAME=insurance_lakehouse
